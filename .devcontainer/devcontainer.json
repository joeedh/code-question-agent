{
  "name": "code-question-agent",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "node",

  "runArgs": ["--security-opt=no-new-privileges", "--network=host"],

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vitest.explorer"
      ]
    }
  },

  "onCreateCommand": "createCommand.sh",
  "postCreateCommand": ""
}
